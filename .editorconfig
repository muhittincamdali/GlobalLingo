root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

# Fixture projects are kept byte for byte as Xcode, Flutter and npm wrote them; some .strings
# files are UTF-16 on purpose.
[fixtures/**]
indent_style = unset
indent_size = unset
charset = unset
trim_trailing_whitespace = false
insert_final_newline = unset

[test/data/**]
charset = unset
trim_trailing_whitespace = false
insert_final_newline = unset
